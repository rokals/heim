[Unit]
Description=Heim - noyau domotique
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=heim
Group=heim
ExecStart=/usr/local/bin/heim
WorkingDirectory=/var/lib/heim
Environment=HEIM_DATA_DIR=/var/lib/heim
Environment=HEIM_HTTP=0.0.0.0:8090
Environment=HEIM_MQTT_HOST=127.0.0.1
# Mettre le jeton et les identifiants MQTT dans /etc/heim.env (chmod 600) :
#   HEIM_TOKEN=...
#   HEIM_MQTT_USER=...
#   HEIM_MQTT_PASSWORD=...
EnvironmentFile=-/etc/heim.env
Restart=always
RestartSec=3
# Garde-fou mémoire pour un Pi Zero 2 W
MemoryMax=128M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/heim
PrivateTmp=true

[Install]
WantedBy=multi-user.target
